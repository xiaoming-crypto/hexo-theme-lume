<%
  const tagName = page.tag || '';
  const count = page.posts ? page.posts.length : 0;
%>
<section class="term-page">
  <header class="page-head">
    <p class="eyebrow">Tag</p>
    <h1><span class="tag-hash" aria-hidden="true">#</span><%= tagName %></h1>
    <p class="page-head__meta"><%= __('stats.postsCount', count) %><%= page.total > 1 ? ' · ' + __('home.pageOf', page.current, page.total) : '' %></p>
  </header>

  <div class="entries">
    <% page.posts.each(function (post, index) { %>
      <%- partial('_partial/entry', { post: post, index: index }) %>
    <% }) %>
  </div>

  <%- partial('_partial/pagination') %>
</section>
