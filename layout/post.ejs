<%
  const post = page;
  const postOptions = theme.post || {};
  const categories = (post.categories && post.categories.toArray) ? post.categories.toArray() : [];
  const tags = (post.tags && post.tags.toArray) ? post.tags.toArray() : [];
  const tocHTML = postOptions.showToc === false ? '' : toc(post.content, { list_number: false, max_depth: 3 });
  const minutes = lume_reading_time(post.content);
  const words = lume_word_count(post.content);
  const showCover = postOptions.showCover !== false && !!post.cover;
  const updated = post.updated && post.date && (post.updated.valueOf() - post.date.valueOf() > 60000);
  const comments = theme.comments || {};
  const provider = comments.provider || 'giscus';
  const giscus = comments.giscus || {};
  const twikoo = comments.twikoo || {};
  const hasComments = !!comments.enable && ((provider === 'giscus' && giscus.repo) || (provider === 'twikoo' && twikoo.envId));
  const colorConf = (theme.color && theme.color.mainTone) || {};
  const relatedConf = postOptions.related || {};
  const relatedPosts = relatedConf.enable === false ? [] : lume_related_posts(post, relatedConf.count || 3);
  const seriesPosts = lume_series_posts(post);
  const seriesIndex = seriesPosts.findIndex(function (item) { return item.path === post.path; });
  const outdatedDays = typeof postOptions.outdatedDays === 'number' ? postOptions.outdatedDays : 365;
  const showOutdated = outdatedDays > 0 && post.outdated !== false;
%>
<article class="post"
         <% if (post.cover) { %>data-color-img="<%= post.cover %>"<% } %>
         <% if (post.main_color) { %>data-main-color="<%= post.main_color %>"<% } %>
         data-color-api="<%= colorConf.api || '' %>"
         data-cover-change="<%= colorConf.coverChange === false ? 'false' : 'true' %>"
         data-color-enabled="<%= colorConf.enable === false ? 'false' : 'true' %>">
  <header class="post-head">
    <nav class="post-crumb" aria-label="Breadcrumb" data-reveal>
      <a href="<%= url_for('/') %>"><%= __('nav.home') %></a>
      <span aria-hidden="true">/</span>
      <% if (categories.length) { %>
        <a href="<%= url_for(categories[0].path) %>"><%= categories[0].name %></a>
        <span aria-hidden="true">/</span>
      <% } %>
      <span class="post-crumb__current"><%= post.title %></span>
    </nav>

    <% if (categories.length) { %>
    <p class="post-kicker" data-reveal style="--i: 1">
      <span aria-hidden="true">✦</span>
      <% categories.forEach(function (category, index) { %>
        <a href="<%= url_for(category.path) %>"><%= category.name %></a><% if (index < categories.length - 1) { %><span aria-hidden="true">,</span><% } %>
      <% }) %>
    </p>
    <% } %>

    <h1 class="post-title" data-reveal style="--i: 1"><%= post.title %></h1>

    <% if (post.description) { %>
      <p class="post-dek" data-reveal style="--i: 2"><%= post.description %></p>
    <% } %>

    <div class="post-meta" data-reveal style="--i: 3">
      <span class="post-meta__item">
        <%- lume_icon('calendar') %>
        <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
      </span>
      <% if (updated && postOptions.showUpdated !== false) { %>
        <span class="post-meta__item"><%= __('post.updated') %> <time datetime="<%= date_xml(post.updated) %>"><%= date(post.updated, 'YYYY-MM-DD') %></time></span>
      <% } %>
      <% if (postOptions.showReadingTime !== false) { %>
        <span class="post-meta__item"><%- lume_icon('clock') %><%= minutes %> <%= __('post.minutes') %></span>
      <% } %>
      <% if (postOptions.showWordCount !== false) { %>
        <span class="post-meta__item"><%= words %> <%= __('post.words') %></span>
      <% } %>
      <% if (hasComments && provider === 'twikoo' && twikoo.count !== false) { %>
        <span class="post-meta__item" data-comment-count-wrap hidden><%- lume_icon('message') %><span data-comment-count>0</span></span>
      <% } %>
      <% if (hasComments && provider === 'twikoo' && twikoo.visitor) { %>
        <span class="post-meta__item" data-visitor-count-wrap hidden><%- lume_icon('eye') %><span id="twikoo_visitors" data-visitor-count></span></span>
      <% } %>
      <button class="post-meta__item post-share-btn" type="button" data-copy-link aria-label="<%= __('action.copyLink') %>">
        <%- lume_icon('link') %><span data-copy-link-label><%= __('action.copyLink') %></span>
      </button>
      <button class="post-meta__item post-focus-btn" type="button" data-reading-focus aria-pressed="false" aria-label="<%= __('action.focusMode') %>">
        <%- lume_icon('expand', 'post-focus-btn__ico-on') %><%- lume_icon('shrink', 'post-focus-btn__ico-off') %><span data-reading-focus-label><%= __('action.focusMode') %></span>
      </button>
    </div>
  </header>

  <% if (showCover) { %>
  <figure class="post-cover" data-post-cover>
    <div class="post-cover__frame">
      <img src="<%= post.cover %>" alt="<%= post.title %>" loading="eager" decoding="async" fetchpriority="high">
    </div>
    <% if (post.coverCaption) { %><figcaption><%= post.coverCaption %></figcaption><% } %>
  </figure>
  <% } %>

  <div class="post-layout">
    <div class="post-main">
      <% if (tocHTML) { %>
      <details class="toc-mobile" data-toc>
        <summary><%= __('post.toc') %><span class="toc-mobile__count"><%= tocHTML.split('<li').length - 1 %></span></summary>
        <div class="toc-mobile__body"><%- tocHTML %></div>
      </details>
      <% } %>

      <% if (showOutdated) { %>
      <aside class="post-outdated" data-outdated-days="<%= outdatedDays %>" data-post-updated="<%= date_xml(post.updated || post.date) %>" data-post-date-label="<%= date(post.updated || post.date, 'YYYY-MM-DD') %>" data-outdated-template="<%= __('post.outdatedNotice') %>" role="note" hidden>
        <span class="post-outdated__icon" aria-hidden="true"><%- lume_icon('hourglass') %></span>
        <p class="post-outdated__text" data-outdated-text></p>
      </aside>
      <% } %>

      <% if (seriesPosts.length > 1) { %>
      <details class="post-series" open>
        <summary>
          <span class="post-series__title"><%- lume_icon('layers') %> <%= __('post.series') %> · <%= post.series %></span>
          <span class="post-series__count"><%= (seriesIndex >= 0 ? seriesIndex + 1 : 1) %> / <%= seriesPosts.length %></span>
        </summary>
        <ol class="post-series__list">
          <% seriesPosts.forEach(function (item, idx) { %>
            <% const activeSeries = item.path === post.path; %>
            <li class="<%= activeSeries ? 'is-current' : '' %>">
              <% if (activeSeries) { %>
                <span class="post-series__link" aria-current="page"><span class="post-series__idx"><%= String(idx + 1).padStart(2, '0') %></span><%= item.title %></span>
              <% } else { %>
                <a class="post-series__link" href="<%= url_for(item.path) %>"><span class="post-series__idx"><%= String(idx + 1).padStart(2, '0') %></span><%= item.title %></a>
              <% } %>
            </li>
          <% }); %>
        </ol>
      </details>
      <% } %>

      <div class="post-body" data-article data-math-force="<%= post.math ? 'true' : 'false' %>">
        <%- post.content %>
      </div>

      <footer class="post-end">
        <% if (tags.length) { %>
        <ul class="post-tags" aria-label="Tags" data-reveal>
          <% tags.forEach(function (tag) { %>
            <li><a href="<%= url_for(tag.path) %>"><span aria-hidden="true">#</span><%= tag.name %></a></li>
          <% }) %>
        </ul>
        <% } %>

        <% if (postOptions.license) { %>
        <aside class="license" data-reveal>
          <p class="license__label"><%= __('post.license') %></p>
          <p><%= postOptions.license %></p>
        </aside>
        <% } %>
      </footer>

      <%
        const rewardConf = theme.reward || {};
        const rewardMethods = rewardConf.methods || {};
        const rewardKeys = Object.keys(rewardMethods).filter(function (key) {
          return rewardMethods[key] && (rewardMethods[key].label || rewardMethods[key].image);
        });
      %>
      <% if (rewardConf.enable && rewardKeys.length) { %>
      <section class="reward" data-reward>
        <span class="reward__sticker" aria-hidden="true">♥</span>
        <div class="reward__copy">
          <h2><%= rewardConf.title || '请我喝杯咖啡' %></h2>
          <p><%= rewardConf.intro || '如果这篇内容帮到了你，可以请我喝杯咖啡。' %></p>
        </div>
        <button class="btn btn--pop reward__open" type="button" data-reward-open aria-haspopup="dialog">
          打赏一下 <%- lume_icon('heart') %>
        </button>
      </section>

      <dialog class="reward-modal" data-reward-modal aria-labelledby="reward-title">
        <div class="reward-modal__card">
          <button class="reward-modal__close" type="button" data-reward-close aria-label="关闭打赏弹层">×</button>
          <p class="reward-modal__kicker" aria-hidden="true">☕ Support</p>
          <h2 id="reward-title"><%= rewardConf.title || '请我喝杯咖啡' %></h2>
          <p class="reward-modal__intro"><%= rewardConf.intro || '' %></p>

          <div class="reward-methods" role="tablist" aria-label="支付方式">
            <% rewardKeys.forEach(function (key, index) { %>
            <button class="reward-method<%= index === 0 ? ' is-active' : '' %>" type="button" role="tab"
                    aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                    aria-controls="reward-panel-<%= key %>" data-reward-method="<%= key %>">
              <span class="reward-method__dot" aria-hidden="true"></span><%= rewardMethods[key].label || key %>
            </button>
            <% }); %>
          </div>

          <div class="reward-panels">
            <% rewardKeys.forEach(function (key, index) { %>
            <figure class="reward-panel<%= index === 0 ? ' is-active' : '' %>" id="reward-panel-<%= key %>" role="tabpanel" data-reward-panel="<%= key %>"<%= index === 0 ? '' : ' hidden' %>>
              <% if (rewardMethods[key].image) { %>
                <img class="reward-panel__qr" src="<%= url_for(rewardMethods[key].image) %>" alt="<%= (rewardMethods[key].label || key) %>收款码" loading="lazy" decoding="async">
              <% } %>
              <figcaption><%= rewardMethods[key].label || key %>收款码</figcaption>
            </figure>
            <% }); %>
          </div>

          <p class="reward-modal__note"><%- lume_icon('lock') %><%= rewardConf.note || '扫码仅用于展示收款码，本站不会发起扣款，也不会收集任何支付信息。' %></p>
        </div>
      </dialog>
      <% } %>

      <% if (postOptions.prevNext !== false && (post.prev || post.next)) { %>
      <nav class="post-nav" aria-label="Post navigation">
        <% if (post.prev) { %>
        <a class="post-nav__item post-nav__item--prev" href="<%= url_for(post.prev.path) %>">
          <span class="post-nav__label"><span aria-hidden="true">←</span> <%= __('post.prev') %></span>
          <span class="post-nav__title"><%= post.prev.title %></span>
        </a>
        <% } else { %><span class="post-nav__item is-empty" aria-hidden="true"></span><% } %>

        <% if (post.next) { %>
        <a class="post-nav__item post-nav__item--next" href="<%= url_for(post.next.path) %>">
          <span class="post-nav__label"><%= __('post.next') %> <span aria-hidden="true">→</span></span>
          <span class="post-nav__title"><%= post.next.title %></span>
        </a>
        <% } else { %><span class="post-nav__item is-empty" aria-hidden="true"></span><% } %>
      </nav>
      <% } %>

      <% if (relatedPosts.length) { %>
      <section class="related-posts" aria-labelledby="related-title" data-reveal>
        <h2 class="related-posts__title" id="related-title"><%- lume_icon('sparkles') %><%= __('post.related') %></h2>
        <div class="related-grid">
          <% relatedPosts.forEach(function (rel) { %>
            <% const relCats = (rel.categories && rel.categories.toArray) ? rel.categories.toArray() : []; %>
            <a class="related-card" href="<%= url_for(rel.path) %>">
              <span class="related-card__meta">
                <time datetime="<%= date_xml(rel.date) %>"><%= date(rel.date, 'YYYY-MM-DD') %></time>
                <% if (relCats.length) { %><span class="related-card__cat"><%= relCats[0].name %></span><% } %>
              </span>
              <strong class="related-card__title"><%= rel.title %></strong>
              <span class="related-card__read"><%- lume_icon('clock') %> <%= lume_reading_time(rel.content) %> <%= __('post.minutes') %></span>
            </a>
          <% }); %>
        </div>
      </section>
      <% } %>

      <%- partial('_partial/comments') %>
    </div>

    <% if (tocHTML) { %>
    <aside class="post-aside">
      <div class="post-aside__inner" data-toc>
        <p class="post-aside__label"><%= __('post.toc') %></p>
        <%- tocHTML %>
      </div>
    </aside>
    <% } %>
  </div>
</article>
