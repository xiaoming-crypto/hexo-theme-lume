<%
  const f = theme.footer || {};
  const social = theme.social || [];
  const posts = site.posts.toArray ? site.posts.toArray() : (site.posts.data || []);
  const years = posts.map(function (p) { return p.date.format('YYYY'); }).sort();
  const since = f.since || (years.length ? years[0] : '');
  const now = new Date().getFullYear();
  const range = since && String(since) !== String(now) ? since + '–' + now : String(now);
  const icp = f.icp || {};
  const police = f.police || {};
%>
<footer class="site-footer" id="site-footer">
  <div class="footer__doodle" aria-hidden="true">
    <svg viewBox="0 0 1200 28" preserveAspectRatio="none"><path d="M0 18c60-18 120 18 180 0s120-18 180 0 120 18 180 0 120-18 180 0 120 18 180 0 120-18 180 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  </div>
  <div class="footer__inner">
    <div class="footer__intro">
      <div class="footer__brand">
        <div>
          <strong><%= config.title %></strong>
          <p><%= f.note || config.description || '保持好奇，继续建造。' %></p>
        </div>
      </div>

      <div class="footer__stats">
        <span><b><%= site.posts.length %></b> 篇文章</span>
        <span><b><%= site.categories.length %></b> 个分类</span>
        <span><b><%= site.tags.length %></b> 个标签</span>
      </div>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h3>逛一逛</h3>
        <a href="<%= url_for('/archives/') %>">全部文章</a>
        <a href="<%= url_for('/categories/') %>">分类</a>
        <a href="<%= url_for('/tags/') %>">标签</a>
        <a href="<%= url_for('/link/') %>">友链</a>
        <a href="<%= url_for('/music/') %>">音乐</a>
      </div>
      <div class="footer__col">
        <h3>在这里</h3>
        <% social.forEach(function (item) { %>
          <% const isExternal = /^https?:\/\//i.test(String(item.url || '')); %>
          <a href="<%= item.url %>"<% if (isExternal) { %> target="_blank" rel="noopener noreferrer"<% } %>><%= item.name %></a>
        <% }); %>
        <% if (theme.rss) { %><a href="<%= url_for(theme.rss) %>">RSS</a><% } %>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__legal">
      <span>© <%= range %> <%= config.author || config.title %></span>
      <% if (icp.text) { %><a data-footer-icp href="<%= icp.link || 'https://beian.miit.gov.cn/' %>" target="_blank" rel="noopener noreferrer"><%= icp.text %></a><% } %>
      <% if (police.text) { %><a href="<%= police.link || '#' %>" target="_blank" rel="noopener noreferrer"><%= police.text %></a><% } %>
    </div>
    <div class="footer__meta">
      <% if (f.poweredBy !== false) { %><span>Powered by <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a> · <a href="https://github.com/xiaoming-crypto/hexo-theme-lume" target="_blank" rel="noopener noreferrer">Lume</a></span><% } %>
      <% if (f.license) { %><span class="footer__license"><%= f.license %></span><% } %>
    </div>
  </div>
</footer>
